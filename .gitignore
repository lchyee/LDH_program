# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# IDE
.DS_Store
.vscode
.idea/

# Archives
*.zip
*.tar

# Data files (can be regenerated)
data/stock_data.csv
data/train.csv
data/test.csv

# Model checkpoints (will be retrained)
model/*/checkpoint/*.pth
model/*/checkpoint/*.pkl
model/*/checkpoint/log/
model/*/checkpoint/*.json

# Output files
output/
model/*/output/

# Temp files
temp/

# Backtest outputs (results are regenerated by running the backtest)
backtest/results/
backtest/_verify_sample_results/
backtest/_verify_run.log
backtest/_backup_before_test/
